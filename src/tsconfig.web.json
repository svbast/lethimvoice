{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"jsx": "preserve",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"rootDir": "..",
		"tsBuildInfoFile": "../node_modules/.tmp/tsconfig.web.tsbuildinfo"
	},
	"include": ["**/*.d.ts", "**/*.ts", "**/*.tsx"],
}
